<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar">
      <text class="avatar-icon">👤</text>
    </view>
    <view class="user-info">
      <text class="username">经期记录用户</text>
      <text class="user-desc">记录健康，关爱自己</text>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-section">
    <view class="stats-title">📊 健康统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{stats.totalRecords}}</text>
        <text class="stat-label">记录天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.totalPeriods}}</text>
        <text class="stat-label">经期次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.avgCycle}}</text>
        <text class="stat-label">平均周期</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{symptomCount}}</text>
        <text class="stat-label">症状类型</text>
      </view>
    </view>
  </view>

  <!-- 设置选项 -->
  <view class="settings-section">
    <view class="section-title">⚙️ 设置</view>
    
    <view class="setting-item" bindtap="openCycleSettings">
      <view class="setting-left">
        <text class="setting-icon">📅</text>
        <text class="setting-text">周期设置</text>
      </view>
      <view class="setting-right">
        <text class="setting-value">平均{{settings.avgCycle}}天</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="setting-item" bindtap="toggleReminder">
      <view class="setting-left">
        <text class="setting-icon">🔔</text>
        <text class="setting-text">提醒功能</text>
      </view>
      <view class="setting-right">
        <text class="setting-value">{{settings.reminderEnabled ? '已开启' : '已关闭'}}</text>
        <switch checked="{{settings.reminderEnabled}}" color="#FF6B81" bindchange="toggleReminder"/>
      </view>
    </view>

    <view class="setting-item" bindtap="openAbout">
      <view class="setting-left">
        <text class="setting-icon">ℹ️</text>
        <text class="setting-text">关于应用</text>
      </view>
      <view class="setting-right">
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="settings-section">
    <view class="section-title">💾 数据管理</view>
    
    <view class="setting-item" bindtap="exportData">
      <view class="setting-left">
        <text class="setting-icon">📤</text>
        <text class="setting-text">导出数据</text>
      </view>
      <view class="setting-right">
        <text class="setting-desc">备份健康数据</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="setting-item" bindtap="importData">
      <view class="setting-left">
        <text class="setting-icon">📥</text>
        <text class="setting-text">导入数据</text>
      </view>
      <view class="setting-right">
        <text class="setting-desc">恢复备份数据</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="setting-item danger" bindtap="clearData">
      <view class="setting-left">
        <text class="setting-icon">🗑️</text>
        <text class="setting-text">清空数据</text>
      </view>
      <view class="setting-right">
        <text class="setting-desc">谨慎操作</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version">v1.0.0 正式版</text>
    <text class="copyright">© 2026 经期记录</text>
  </view>
</view>
