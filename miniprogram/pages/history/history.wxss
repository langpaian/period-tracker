/* pages/history/history.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 30rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.record-date {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-main {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.date-sub {
  font-size: 24rpx;
  color: #999;
}

.record-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-flow {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.flow-icon {
  font-size: 28rpx;
}

.flow-text {
  font-size: 28rpx;
  color: #666;
}

.record-symptoms {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.symptom-icon {
  font-size: 24rpx;
}

.symptom-text {
  font-size: 26rpx;
  color: #666;
}

.record-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f9f9f9;
  padding: 10rpx 15rpx;
  border-radius: 10rpx;
}

.note-icon {
  font-size: 24rpx;
}

.note-text {
  font-size: 26rpx;
  color: #666;
  word-wrap: break-word;
}

.record-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.tag-start {
  background: #FFE0E6;
  color: #FF6B81;
}

.tag-end {
  background: #E6FFF0;
  color: #4CAF50;
}

.record-time {
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: right;
}

.time-text {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}
